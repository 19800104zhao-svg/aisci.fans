AISCI_ADMIN_EMAILS="19800104zhao@gmail.com"

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-a-long-random-string"

# Optional source API keys.
SEMANTIC_SCHOLAR_API_KEY=""
NCBI_API_KEY=""
